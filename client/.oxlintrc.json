{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/components/ui"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "react/react-in-jsx-scope": "off",

    "no-nested-ternary": "error",
    "no-else-return": "error",
    "max-params": ["error", { "max": 4 }],
    "max-depth": ["error", { "max": 4 }],
    // max-lines-per-function is deliberately OFF. It measures length, and a
    // React component's length is mostly markup — `UsersPage` was ~25 lines of
    // logic under ~85 of JSX when this rule called it too long. In this repo it
    // fired twice and the correct action was "do nothing" both times: at 106
    // lines on CreateUserForm (where it was also miscounting comments, and was
    // very nearly used to justify a FormField wrapper that had to be reverted)
    // and at 110 on UsersPage. Zero true positives.
    // `CLAUDE.md` already lists "the linter says it's too long" as a reason that
    // is not a reason, so keeping the rule meant shipping a warning we had
    // pre-committed to ignoring — which only teaches us to skim past lint
    // output. **When to extract a unit** in CLAUDE.md is the real rule.
    // max-lines (whole file) stays: it fired once, on a spec file holding three
    // verbs, and splitting it was right.
    "max-lines": ["warn", { "max": 300 }]
  },
  // Layer direction, enforced. `pages` may import `features`, and both may
  // import the shared folders — never the other way round. oxlint has no
  // `import/no-restricted-paths`, so each zone is an override that forbids the
  // imports pointing the wrong way.
  "overrides": [
    {
      // A feature reaches down to shared code only. Its own files are imported
      // relatively (`./CreateUserForm`), which is why every `@/features/...`
      // spelling in here is by definition another feature.
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/**"],
                "message": "Inside src/features, name your own feature's files relatively (./Thing) and never name another feature at all. Anything two features need belongs in src/components or src/lib."
              },
              {
                "group": ["**/pages/**", "**/App*"],
                "message": "A feature may not import the page that mounts it — that is the layer above. Pass what it needs in as props."
              }
            ]
          }
        ]
      }
    },
    {
      // The shared layer is the bottom: it cannot know who uses it.
      "files": ["src/components/**", "src/lib/**", "src/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/**", "**/pages/**", "**/App*"],
                "message": "Shared code may not import a feature or a page. If it needs one, it is not shared — move it into that feature."
              }
            ]
          }
        ]
      }
    }
  ]
}
