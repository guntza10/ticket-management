{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/components/ui"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "react/react-in-jsx-scope": "off",

    "no-nested-ternary": "error",
    "no-else-return": "error",
    "max-params": ["error", { "max": 4 }],
    "max-depth": ["error", { "max": 4 }],
    // skipComments because this repo's house style is dense explanatory
    // comments, so counting them made the rule measure prose rather than how
    // much the function does. It fired at 106 lines on a 3-field form and was
    // very nearly used to justify splitting that form into another component —
    // reshaping code to satisfy a misconfigured tool. Measure the code.
    "max-lines-per-function": [
      "warn",
      { "max": 100, "skipComments": true, "skipBlankLines": true }
    ],
    "max-lines": ["warn", { "max": 300 }]
  },
  // Layer direction, enforced. `pages` may import `features`, and both may
  // import the shared folders — never the other way round. oxlint has no
  // `import/no-restricted-paths`, so each zone is an override that forbids the
  // imports pointing the wrong way.
  "overrides": [
    {
      // A feature reaches down to shared code only. Its own files are imported
      // relatively (`./CreateUserForm`), which is why every `@/features/...`
      // spelling in here is by definition another feature.
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**"],
                "message": "A feature may not import another feature. Import its own files relatively (./Thing), and move anything two features need into src/components or src/lib."
              },
              {
                "group": ["@/pages/**", "@/App*"],
                "message": "A feature may not import the page that mounts it — that is the layer above. Pass what it needs in as props."
              }
            ]
          }
        ]
      }
    },
    {
      // The shared layer is the bottom: it cannot know who uses it.
      "files": ["src/components/**", "src/lib/**", "src/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/pages/**", "@/App*"],
                "message": "Shared code may not import a feature or a page. If it needs one, it is not shared — move it into that feature."
              }
            ]
          }
        ]
      }
    }
  ]
}
