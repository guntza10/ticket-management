// Prisma schema — https://pris.ly/d/prisma-schema
// The database connection URL lives in prisma.config.ts (reads DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// First model — a minimal, standalone Ticket to prove the pipe end-to-end.
// Relations to User/Agent and richer fields are added in later phases.
model Ticket {
  id        Int      @id @default(autoincrement())
  subject   String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket")
}
