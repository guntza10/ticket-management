{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "node"],
  "ignorePatterns": ["src/generated"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "import/no-unassigned-import": "off",
    // Written for Express 4, which dropped a rejected promise on the floor.
    // Express 5 forwards it to the error-handling middleware, which is the
    // behaviour this codebase relies on (see CLAUDE.md "Error handling") — so
    // the rule would force a .catch(next) wrapper around every async route to
    // no purpose. It was never protecting the routes here anyway: it skips a
    // handler whose request parameter is named `_req`, which is how the
    // pre-existing async GET /api/users passed it.
    "no-async-endpoint-handlers": "off",

    "no-nested-ternary": "error",
    "no-else-return": "error",
    "max-params": ["error", { "max": 4 }],
    "max-depth": ["error", { "max": 4 }],
    // max-lines-per-function is deliberately OFF. It measures length, and a
    // React component's length is mostly markup — `UsersPage` was ~25 lines of
    // logic under ~85 of JSX when this rule called it too long. In this repo it
    // fired twice and the correct action was "do nothing" both times: at 106
    // lines on CreateUserForm (where it was also miscounting comments, and was
    // very nearly used to justify a FormField wrapper that had to be reverted)
    // and at 110 on UsersPage. Zero true positives.
    // `CLAUDE.md` already lists "the linter says it's too long" as a reason that
    // is not a reason, so keeping the rule meant shipping a warning we had
    // pre-committed to ignoring — which only teaches us to skim past lint
    // output. **When to extract a unit** in CLAUDE.md is the real rule.
    // max-lines (whole file) stays: it fired once, on a spec file holding three
    // verbs, and splitting it was right.
    "max-lines": [
      "warn",
      { "max": 300, "skipComments": true, "skipBlankLines": true }
    ]
  },
  // Import direction, enforced. `index.ts` may import a module; a module may
  // import the shared files at `src/` root and `core/`; the shared files may
  // import neither. oxlint has no `import/no-restricted-paths`, so each zone is
  // an override that forbids the imports pointing the wrong way.
  //
  // Only two of the three zones are expressible — see **Module layout** in
  // CLAUDE.md for the third and why it stays prose.
  "overrides": [
    {
      // The shared layer is the bottom: db.ts, auth.ts, config.ts and the
      // require-* guards cannot know who uses them.
      //
      // The module folders are named rather than globbed as `./*/**`, because
      // `db.ts` legitimately imports `./generated/prisma/client.ts` and that
      // glob would catch it. Cost of being explicit: a new module has to be
      // added here. excludeFiles exempts index.ts, where importing a router is
      // the wiring this file exists to do.
      "files": ["src/*.ts"],
      "excludeFiles": ["src/index.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./users/**", "./tickets/**"],
                "message": "Shared code at src/ root may not import a module. If a module needs this, it belongs here; if this needs a module, it is not shared."
              }
            ]
          }
        ]
      }
    },
    {
      // A module may not reach up into the wiring that mounts it.
      "files": ["src/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/index.ts"],
                "message": "A module may not import src/index.ts — that is the layer above. Anything you need from it moves down to src/ root."
              }
            ]
          }
        ]
      }
    }
  ]
}
