# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/ticket_management?schema=public"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-char-min-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# Admin seed (npm run db:seed) — the first admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Optional second account, seeded only when both are set. A non-admin session
# is the only way to check locally that an admin-only endpoint really refuses.
AGENT_EMAIL="agent@example.com"
AGENT_PASSWORD="change-me"

# Shared secret the inbound-email webhook requires in the x-webhook-secret
# header — generate one with: openssl rand -base64 32
# The server refuses to start without it, the same as BETTER_AUTH_SECRET.
WEBHOOK_SECRET=
