# Copy to .env.test and fill in real values. Never commit .env.test.
# Loaded by the Playwright E2E run (see ../playwright.config.ts).
# NEVER point DATABASE_URL at the dev database — test data here is disposable.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ticket_management_test?schema=public"

# The test API runs on its own port so a dev server on 3000 keeps working.
NODE_ENV=test
PORT=3001
CLIENT_ORIGIN="http://localhost:5174"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-char-min-secret-here"
BETTER_AUTH_URL="http://localhost:3001"

# Fixed credentials the E2E tests sign in with (npm run db:seed:test).
ADMIN_EMAIL="admin@test.local"
ADMIN_PASSWORD="password1234"

# A non-admin account, so role-gating can be tested from an agent session.
AGENT_EMAIL="agent@test.local"
AGENT_PASSWORD="password1234"
