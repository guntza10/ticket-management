{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "start:test": "node --env-file=.env.test src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.ts",
    "db:migrate:test": "DOTENV_CONFIG_PATH=.env.test prisma migrate deploy",
    "db:seed:test": "node --env-file=.env.test prisma/seed.ts",
    "db:reset:test": "DOTENV_CONFIG_PATH=.env.test prisma migrate reset --force --skip-seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.23",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "oxlint": "^1.75.0",
    "prisma": "^7.8.0",
    "typescript": "~6.0.2"
  }
}
